#!/usr/bin/env bash
# Throwaway Buzz relay + envchain namespaces for live botserver tests.
# Never prints secret values.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
PROOF="${BOTSERVER_PROOF_DIR:-$HOME/tmp-botserver-proof}"
COMPOSE="$PROOF/docker-compose.yml"
RELAY_BIN="${BUZZ_RELAY_BIN:-$HOME/code/buzz/target/release/buzz-relay}"
NS_OP=botserver-proof
NS_PEER=botserver-proof-peer
BIND=127.0.0.1:13001
HEALTH=18081

usage() {
  echo "usage: $0 up|down|status|smoke|trigger [--content TEXT]" >&2
  exit 2
}

umask 077
mkdir -p "$PROOF"

ensure_compose() {
  cat > "$COMPOSE" << 'YML'
name: botserver-proof
services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: buzz
      POSTGRES_PASSWORD: buzz_dev
      POSTGRES_DB: buzz
    ports:
      - "127.0.0.1:25433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U buzz"]
      interval: 3s
      timeout: 3s
      retries: 20
  redis:
    image: redis:7-alpine
    ports:
      - "127.0.0.1:26380:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 3s
      timeout: 3s
      retries: 20
YML
}

ensure_keys() {
  command -v nak >/dev/null || {
    echo "local-relay: nak not on PATH" >&2
    exit 1
  }
  if [ ! -s "$PROOF/operator.nsec" ] && [ -s "$PROOF/human.nsec" ]; then
    cp "$PROOF/human.nsec" "$PROOF/operator.nsec"
  fi
  if [ ! -s "$PROOF/operator.nsec" ]; then
    nak key generate > "$PROOF/operator.nsec"
  fi
  if [ ! -s "$PROOF/peer.nsec" ]; then
    nak key generate > "$PROOF/peer.nsec"
  fi
  if [ ! -s "$PROOF/relay.hex" ]; then
    openssl rand -hex 32 > "$PROOF/relay.hex"
  fi
  nak key public < "$PROOF/operator.nsec" > "$PROOF/operator.pub"
  nak key public < "$PROOF/peer.nsec" > "$PROOF/peer.pub"
  chmod 600 "$PROOF"/operator.nsec "$PROOF"/peer.nsec "$PROOF"/relay.hex
}

ensure_envchain() {
  command -v envchain >/dev/null || {
    echo "local-relay: envchain not on PATH" >&2
    exit 1
  }
  < "$PROOF/operator.nsec" envchain --set "$NS_OP" BUZZ_PRIVATE_KEY >/dev/null 2>&1
  printf 'ws://127.0.0.1:13001\n' | envchain --set "$NS_OP" BUZZ_RELAY_URL >/dev/null 2>&1
  < "$PROOF/peer.nsec" envchain --set "$NS_PEER" BUZZ_PRIVATE_KEY >/dev/null 2>&1
  printf 'ws://127.0.0.1:13001\n' | envchain --set "$NS_PEER" BUZZ_RELAY_URL >/dev/null 2>&1
}

wait_healthy() {
  local i
  for i in $(seq 1 40); do
    pg=$(docker inspect --format '{{.State.Health.Status}}' botserver-proof-postgres-1 2>/dev/null || echo missing)
    rd=$(docker inspect --format '{{.State.Health.Status}}' botserver-proof-redis-1 2>/dev/null || echo missing)
    if [ "$pg" = healthy ] && [ "$rd" = healthy ]; then
      return 0
    fi
    sleep 1
  done
  echo "local-relay: postgres/redis not healthy" >&2
  exit 1
}

relay_up() {
  if python3 -c 'import socket,sys; s=socket.socket(); s.settimeout(0.3); sys.exit(0 if s.connect_ex(("127.0.0.1",13001))==0 else 1)'; then
    return 0
  fi
  if [ ! -x "$RELAY_BIN" ]; then
    echo "local-relay: missing $RELAY_BIN" >&2
    exit 1
  fi
  (
    export DATABASE_URL='postgres://buzz:buzz_dev@127.0.0.1:25433/buzz'
    export REDIS_URL='redis://127.0.0.1:26380'
    export BUZZ_BIND_ADDR="$BIND"
    export BUZZ_HEALTH_PORT="$HEALTH"
    export BUZZ_METRICS_PORT=19103
    export RELAY_URL='ws://127.0.0.1:13001'
    export BUZZ_REQUIRE_AUTH_TOKEN=false
    export BUZZ_AUTO_MIGRATE=true
    export BUZZ_GIT_CONFORMANCE_PROBE=false
    export BUZZ_AUDIT_ENABLED=false
    export RELAY_OWNER_PUBKEY
    RELAY_OWNER_PUBKEY=$(tr -d ' \n' < "$PROOF/operator.pub")
    export BUZZ_RELAY_PRIVATE_KEY
    BUZZ_RELAY_PRIVATE_KEY=$(tr -d ' \n' < "$PROOF/relay.hex")
    exec "$RELAY_BIN"
  ) >"$PROOF/relay.log" 2>&1 &
  echo $! > "$PROOF/relay.pid"
  local i
  for i in $(seq 1 50); do
    if python3 -c 'import socket,sys; s=socket.socket(); s.settimeout(0.3); sys.exit(0 if s.connect_ex(("127.0.0.1",13001))==0 else 1)'; then
      return 0
    fi
    sleep 0.2
  done
  echo "local-relay: relay did not listen; see $PROOF/relay.log" >&2
  exit 1
}

ensure_channel() {
  if [ -s "$PROOF/channel.id" ]; then
    return 0
  fi
  local json
  json=$(env -u BUZZ_AUTH_TAG envchain "$NS_OP" buzz channels create --name botserver-local --type stream --visibility open)
  python3 -c 'import json,sys; d=json.loads(sys.argv[1]); print(d.get("channel_id") or d.get("id") or "")' "$json" > "$PROOF/channel.id"
  if [ ! -s "$PROOF/channel.id" ]; then
    echo "local-relay: failed to create channel" >&2
    exit 1
  fi
}

cmd_up() {
  ensure_compose
  docker compose -f "$COMPOSE" up -d
  wait_healthy
  ensure_keys
  ensure_envchain
  relay_up
  ensure_channel
  echo "local-relay: up  ws://127.0.0.1:13001  channel=$(tr -d '\n' < "$PROOF/channel.id")"
  echo "local-relay: envchain namespaces $NS_OP (operator) $NS_PEER (peer)"
}

cmd_down() {
  if [ -f "$PROOF/relay.pid" ]; then
    kill "$(cat "$PROOF/relay.pid")" 2>/dev/null || true
    rm -f "$PROOF/relay.pid"
  fi
  docker compose -f "$COMPOSE" down >/dev/null 2>&1 || true
  echo "local-relay: down"
}

cmd_status() {
  python3 -c 'import socket; s=socket.socket(); s.settimeout(0.3); print("relay", "up" if s.connect_ex(("127.0.0.1",13001))==0 else "down")'
  echo -n "channel "
  if [ -s "$PROOF/channel.id" ]; then tr -d '\n' < "$PROOF/channel.id"; echo; else echo none; fi
  echo -n "envchain $NS_OP: "
  envchain --list "$NS_OP" 2>/dev/null | tr '\n' ' ' || echo missing
  echo
}

cmd_smoke() {
  cmd_up
  local channel botcli
  channel=$(tr -d '\n' < "$PROOF/channel.id")
  botcli="$ROOT/target/debug/botcli"
  if [ ! -x "$botcli" ]; then
    cargo build -q -p botcli --manifest-path "$ROOT/Cargo.toml"
  fi
  local receipt event_id
  receipt=$(printf 'local-relay smoke\n' | env -u BUZZ_AUTH_TAG envchain "$NS_OP" "$botcli" send --stdin --channel "$channel")
  echo "$receipt"
  event_id=$(printf '%s\n' "$receipt" | python3 -c 'import json,sys; print(json.load(sys.stdin)["event_id"])')
  env -u BUZZ_AUTH_TAG envchain "$NS_OP" buzz messages get --channel "$channel" --limit 50 \
    | python3 -c 'import json,sys
want=sys.argv[1]
raw=json.load(sys.stdin)
items=raw if isinstance(raw, list) else [raw]
ok=any(
    isinstance(m, dict)
    and (m.get("id") or m.get("event_id")) == want
    and (m.get("content") or "").startswith("[bot]:")
    for m in items
)
print("body_ok" if ok else "body_bad")
raise SystemExit(0 if ok else 1)
' "$event_id"
}

cmd_trigger() {
  local content="hello"
  if [ "${1:-}" = "--content" ]; then
    content=${2:-hello}
  fi
  cmd_up
  local channel op
  channel=$(tr -d '\n' < "$PROOF/channel.id")
  op=$(tr -d ' \n' < "$PROOF/operator.pub")
  env -u BUZZ_AUTH_TAG envchain "$NS_PEER" buzz messages send \
    --channel "$channel" \
    --mention "$op" \
    --content "bot: $content"
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  smoke) cmd_smoke ;;
  trigger) shift; cmd_trigger "$@" ;;
  *) usage ;;
esac
